{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docspec.org/schemas/scale-profile/2.0.json",
  "title": "DocSpec ScaleProfile",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "formatVersion",
        "profileId",
        "workloadKind",
        "workload"
      ],
      "properties": {
        "format": {
          "const": "docspec-scale-profile"
        },
        "formatVersion": {
          "const": "2.0"
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "workloadKind": {
          "const": "document-processing"
        },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "processingPlan",
            "executionProfile",
            "corpus",
            "inputShape",
            "processingGraph",
            "resources",
            "documentStorePolicy",
            "resultSink",
            "profileSet",
            "documentCatalog",
            "baseRelease",
            "placement",
            "cacheState",
            "partitionPolicy",
            "taskPolicy",
            "targets",
            "acceptanceAuthority"
          ],
          "properties": {
            "processingPlan": {
              "$ref": "#/$defs/artifactPin"
            },
            "executionProfile": {
              "$ref": "#/$defs/artifactPin"
            },
            "corpus": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "identity",
                "digest",
                "selectionMethod"
              ],
              "properties": {
                "identity": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "$ref": "#/$defs/sha256"
                },
                "selectionMethod": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "inputShape": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sampleIdentity",
                "sampleDigest",
                "distributions"
              ],
              "properties": {
                "sampleIdentity": {
                  "type": "string",
                  "minLength": 1
                },
                "sampleDigest": {
                  "$ref": "#/$defs/sha256"
                },
                "distributions": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "files",
                    "images",
                    "pages",
                    "bytes",
                    "representations",
                    "segments"
                  ],
                  "properties": {
                    "files": {
                      "$ref": "#/$defs/distribution"
                    },
                    "images": {
                      "$ref": "#/$defs/distribution"
                    },
                    "pages": {
                      "$ref": "#/$defs/distribution"
                    },
                    "bytes": {
                      "$ref": "#/$defs/distribution"
                    },
                    "representations": {
                      "$ref": "#/$defs/distribution"
                    },
                    "segments": {
                      "$ref": "#/$defs/distribution"
                    }
                  }
                }
              }
            },
            "processingGraph": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stageId",
                  "stageKind",
                  "implementationId",
                  "configurationDigest",
                  "inputLayerKinds",
                  "outputLayerKind"
                ],
                "properties": {
                  "stageId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "stageKind": {
                    "enum": [
                      "extractor",
                      "segmenter",
                      "processor"
                    ]
                  },
                  "implementationId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "configurationDigest": {
                    "$ref": "#/$defs/sha256"
                  },
                  "inputLayerKinds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "outputLayerKind": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "minItems": 1
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "environmentId",
                "docspecVersion",
                "pythonVersion",
                "workerCount",
                "workerCpu",
                "workerMemoryBytes",
                "coordinatorMemoryBytes"
              ],
              "properties": {
                "environmentId": {
                  "type": "string",
                  "minLength": 1
                },
                "docspecVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "pythonVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "workerCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "workerCpu": {
                  "type": "integer",
                  "minimum": 1
                },
                "workerMemoryBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "coordinatorMemoryBytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "documentStorePolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maxEntries",
                "maxEstimatedBytes",
                "maxExpectedSegments",
                "maxDurationSeconds"
              ],
              "properties": {
                "maxEntries": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxEstimatedBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxExpectedSegments": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxDurationSeconds": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "resultSink": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sinkId",
                "configurationDigest"
              ],
              "properties": {
                "sinkId": {
                  "type": "string",
                  "minLength": 1
                },
                "configurationDigest": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "profileSet": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profileSetId",
                "pins"
              ],
              "properties": {
                "profileSetId": {
                  "type": "string",
                  "minLength": 1
                },
                "pins": {
                  "type": "array",
                  "minItems": 6,
                  "maxItems": 6,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/profilePin"
                  },
                  "allOf": [
                    {
                      "$ref": "#/$defs/hasReleaseManifestProfile"
                    },
                    {
                      "$ref": "#/$defs/hasDocumentCatalogProfile"
                    },
                    {
                      "$ref": "#/$defs/hasRecordStorageProfile"
                    },
                    {
                      "$ref": "#/$defs/hasBlobStorageProfile"
                    },
                    {
                      "$ref": "#/$defs/hasDocumentStorePersistenceProfile"
                    },
                    {
                      "$ref": "#/$defs/hasResultDeliveryProfile"
                    }
                  ]
                }
              }
            },
            "documentCatalog": {
              "$ref": "#/$defs/implementationPin"
            },
            "baseRelease": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "releaseId",
                    "locator",
                    "digest"
                  ],
                  "properties": {
                    "releaseId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    },
                    "digest": {
                      "$ref": "#/$defs/sha256"
                    }
                  }
                }
              ]
            },
            "placement": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "workerRegion",
                "storageRegion",
                "sourceColocated"
              ],
              "properties": {
                "workerRegion": {
                  "type": "string",
                  "minLength": 1
                },
                "storageRegion": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceColocated": {
                  "type": "boolean"
                }
              }
            },
            "cacheState": {
              "enum": [
                "cold",
                "warm",
                "mixed"
              ]
            },
            "partitionPolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "identity",
                "bucketCount",
                "targetMemberBytes",
                "hardMaxMemberBytes"
              ],
              "properties": {
                "identity": {
                  "type": "string",
                  "minLength": 1
                },
                "bucketCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "targetMemberBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "hardMaxMemberBytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "taskPolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policyId",
                "maxInFlightStores",
                "maxAttempts",
                "checkpointIntervalSeconds"
              ],
              "properties": {
                "policyId": {
                  "type": "string",
                  "minLength": 1
                },
                "maxInFlightStores": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxAttempts": {
                  "type": "integer",
                  "minimum": 1
                },
                "checkpointIntervalSeconds": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "targets": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unitCount",
                "deadlineSeconds",
                "maxWorkerCpu",
                "maxWorkerMemoryBytes",
                "maxCoordinatorMemoryBytes",
                "processorTargets"
              ],
              "properties": {
                "unitCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "deadlineSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxWorkerCpu": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxWorkerMemoryBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxCoordinatorMemoryBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "processorTargets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "processorId",
                      "deadlineSeconds",
                      "maxConcurrency",
                      "costEstimate",
                      "providerLimits"
                    ],
                    "properties": {
                      "processorId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "deadlineSeconds": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "maxConcurrency": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "costEstimate": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "providerLimits": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/providerLimit"
                        },
                        "uniqueItems": true
                      }
                    }
                  }
                }
              }
            },
            "acceptanceAuthority": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "authorityId",
                "decisionArtifact",
                "decisionArtifactDigest"
              ],
              "properties": {
                "authorityId": {
                  "type": "string",
                  "minLength": 1
                },
                "decisionArtifact": {
                  "type": "string",
                  "minLength": 1
                },
                "decisionArtifactDigest": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "formatVersion",
        "profileId",
        "workloadKind",
        "workload"
      ],
      "properties": {
        "format": {
          "const": "docspec-scale-profile"
        },
        "formatVersion": {
          "const": "2.0"
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "workloadKind": {
          "const": "source-catalog"
        },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceNativeInputs",
            "catalogPolicy",
            "requestedUniverse",
            "builder",
            "verifier",
            "proofStrategy",
            "outputProfile",
            "command",
            "referenceMachine",
            "resources",
            "cacheState",
            "measurementMethod",
            "ceilings",
            "acceptanceAuthority"
          ],
          "properties": {
            "sourceNativeInputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/artifactPin"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "catalogPolicy": {
              "$ref": "#/$defs/artifactPin"
            },
            "requestedUniverse": {
              "$ref": "#/$defs/artifactPin"
            },
            "builder": {
              "$ref": "#/$defs/implementationPin"
            },
            "verifier": {
              "$ref": "#/$defs/implementationPin"
            },
            "proofStrategy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "join",
                "order",
                "setProof",
                "maxJoinIds",
                "partitionCount",
                "maxWorkingBytes"
              ],
              "properties": {
                "join": {
                  "$ref": "#/$defs/implementationPin"
                },
                "order": {
                  "$ref": "#/$defs/implementationPin"
                },
                "setProof": {
                  "$ref": "#/$defs/implementationPin"
                },
                "maxJoinIds": {
                  "type": "integer",
                  "minimum": 0
                },
                "partitionCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxWorkingBytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "outputProfile": {
              "$ref": "#/$defs/artifactPin"
            },
            "command": {
              "$ref": "#/$defs/artifactPin"
            },
            "referenceMachine": {
              "$ref": "#/$defs/artifactPin"
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "environmentId",
                "docspecVersion",
                "pythonVersion",
                "workerCount",
                "workerCpu",
                "workerMemoryBytes",
                "coordinatorMemoryBytes"
              ],
              "properties": {
                "environmentId": {
                  "type": "string",
                  "minLength": 1
                },
                "docspecVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "pythonVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "workerCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "workerCpu": {
                  "type": "integer",
                  "minimum": 1
                },
                "workerMemoryBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "coordinatorMemoryBytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "cacheState": {
              "enum": [
                "cold",
                "warm"
              ]
            },
            "measurementMethod": {
              "$ref": "#/$defs/artifactPin"
            },
            "ceilings": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maxSourceRecordCount",
                "maxSourceBytes",
                "maxWallTimeMilliseconds",
                "maxPeakResidentMemoryBytes",
                "maxOutputBytes",
                "maxPayloadBytesWritten",
                "maxPublicationBytesWritten",
                "maxPartitionCount"
              ],
              "properties": {
                "maxSourceRecordCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxSourceBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxWallTimeMilliseconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxPeakResidentMemoryBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxOutputBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxPayloadBytesWritten": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxPublicationBytesWritten": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxPartitionCount": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "acceptanceAuthority": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "authorityId",
                "decisionArtifact",
                "decisionArtifactDigest"
              ],
              "properties": {
                "authorityId": {
                  "type": "string",
                  "minLength": 1
                },
                "decisionArtifact": {
                  "type": "string",
                  "minLength": 1
                },
                "decisionArtifactDigest": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifactPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "locator",
        "digest"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "implementationPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationId",
        "configurationDigest"
      ],
      "properties": {
        "implementationId": {
          "type": "string",
          "minLength": 1
        },
        "configurationDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "median",
        "p95",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 0
        },
        "median": {
          "type": "integer",
          "minimum": 0
        },
        "p95": {
          "type": "integer",
          "minimum": 0
        },
        "maximum": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "providerLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "maximum"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "maximum": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "profilePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "profileId",
        "version",
        "implementationId",
        "configurationDigest",
        "descriptionDigest",
        "capabilities"
      ],
      "properties": {
        "role": {
          "enum": [
            "ReleaseManifestProfile",
            "DocumentCatalogProfile",
            "RecordStorageProfile",
            "BlobStorageProfile",
            "DocumentStorePersistenceProfile",
            "ResultDeliveryProfile"
          ]
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "implementationId": {
          "type": "string",
          "minLength": 1
        },
        "configurationDigest": {
          "$ref": "#/$defs/sha256"
        },
        "descriptionDigest": {
          "$ref": "#/$defs/sha256"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "releaseManifestProfilePin": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "const": "ReleaseManifestProfile"
        }
      }
    },
    "hasReleaseManifestProfile": {
      "contains": {
        "$ref": "#/$defs/releaseManifestProfilePin"
      },
      "minContains": 1,
      "maxContains": 1
    },
    "documentCatalogProfilePin": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "const": "DocumentCatalogProfile"
        }
      }
    },
    "hasDocumentCatalogProfile": {
      "contains": {
        "$ref": "#/$defs/documentCatalogProfilePin"
      },
      "minContains": 1,
      "maxContains": 1
    },
    "recordStorageProfilePin": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "const": "RecordStorageProfile"
        }
      }
    },
    "hasRecordStorageProfile": {
      "contains": {
        "$ref": "#/$defs/recordStorageProfilePin"
      },
      "minContains": 1,
      "maxContains": 1
    },
    "blobStorageProfilePin": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "const": "BlobStorageProfile"
        }
      }
    },
    "hasBlobStorageProfile": {
      "contains": {
        "$ref": "#/$defs/blobStorageProfilePin"
      },
      "minContains": 1,
      "maxContains": 1
    },
    "documentStorePersistenceProfilePin": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "const": "DocumentStorePersistenceProfile"
        }
      }
    },
    "hasDocumentStorePersistenceProfile": {
      "contains": {
        "$ref": "#/$defs/documentStorePersistenceProfilePin"
      },
      "minContains": 1,
      "maxContains": 1
    },
    "resultDeliveryProfilePin": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "const": "ResultDeliveryProfile"
        }
      }
    },
    "hasResultDeliveryProfile": {
      "contains": {
        "$ref": "#/$defs/resultDeliveryProfilePin"
      },
      "minContains": 1,
      "maxContains": 1
    }
  }
}
