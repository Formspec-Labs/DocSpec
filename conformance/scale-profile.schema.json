{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docspec.org/schemas/scale-profile/1.1.json",
  "title": "DocSpec ScaleProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "profileId",
    "processingPlan",
    "executionProfile",
    "corpus",
    "inputShape",
    "processingGraph",
    "resources",
    "documentStorePolicy",
    "resultSink",
    "profileSet",
    "documentCatalog",
    "baseRelease",
    "placement",
    "cacheState",
    "partitionPolicy",
    "taskPolicy",
    "targets",
    "acceptanceAuthority"
  ],
  "properties": {
    "format": { "const": "docspec-scale-profile" },
    "formatVersion": { "const": "1.1" },
    "profileId": { "type": "string", "minLength": 1 },
    "processingPlan": { "$ref": "#/$defs/artifactPin" },
    "executionProfile": { "$ref": "#/$defs/artifactPin" },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "digest", "selectionMethod"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" },
        "selectionMethod": { "type": "string", "minLength": 1 }
      }
    },
    "inputShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleIdentity", "sampleDigest", "distributions"],
      "properties": {
        "sampleIdentity": { "type": "string", "minLength": 1 },
        "sampleDigest": { "$ref": "#/$defs/sha256" },
        "distributions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "images", "pages", "bytes", "representations", "segments"],
          "properties": {
            "files": { "$ref": "#/$defs/distribution" },
            "images": { "$ref": "#/$defs/distribution" },
            "pages": { "$ref": "#/$defs/distribution" },
            "bytes": { "$ref": "#/$defs/distribution" },
            "representations": { "$ref": "#/$defs/distribution" },
            "segments": { "$ref": "#/$defs/distribution" }
          }
        }
      }
    },
    "processingGraph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stageId",
          "stageKind",
          "implementationId",
          "configurationDigest",
          "inputLayerKinds",
          "outputLayerKind"
        ],
        "properties": {
          "stageId": { "type": "string", "minLength": 1 },
          "stageKind": { "enum": ["extractor", "segmenter", "processor"] },
          "implementationId": { "type": "string", "minLength": 1 },
          "configurationDigest": { "$ref": "#/$defs/sha256" },
          "inputLayerKinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "outputLayerKind": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentId",
        "docspecVersion",
        "pythonVersion",
        "workerCount",
        "workerCpu",
        "workerMemoryBytes",
        "coordinatorMemoryBytes"
      ],
      "properties": {
        "environmentId": { "type": "string", "minLength": 1 },
        "docspecVersion": { "type": "string", "minLength": 1 },
        "pythonVersion": { "type": "string", "minLength": 1 },
        "workerCount": { "type": "integer", "minimum": 1 },
        "workerCpu": { "type": "number", "exclusiveMinimum": 0 },
        "workerMemoryBytes": { "type": "integer", "minimum": 1 },
        "coordinatorMemoryBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "documentStorePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxEntries", "maxEstimatedBytes", "maxExpectedSegments", "maxDurationSeconds"],
      "properties": {
        "maxEntries": { "type": "integer", "minimum": 1 },
        "maxEstimatedBytes": { "type": "integer", "minimum": 1 },
        "maxExpectedSegments": { "type": "integer", "minimum": 1 },
        "maxDurationSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "resultSink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sinkId", "configurationDigest"],
      "properties": {
        "sinkId": { "type": "string", "minLength": 1 },
        "configurationDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "profileSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileSetId", "pins"],
      "properties": {
        "profileSetId": { "type": "string", "minLength": 1 },
        "pins": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profilePin" },
          "allOf": [
            { "$ref": "#/$defs/hasReleaseManifestProfile" },
            { "$ref": "#/$defs/hasDocumentCatalogProfile" },
            { "$ref": "#/$defs/hasRecordStorageProfile" },
            { "$ref": "#/$defs/hasBlobStorageProfile" },
            { "$ref": "#/$defs/hasDocumentStorePersistenceProfile" },
            { "$ref": "#/$defs/hasResultDeliveryProfile" }
          ]
        }
      }
    },
    "documentCatalog": { "$ref": "#/$defs/implementationPin" },
    "baseRelease": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["releaseId", "locator", "digest"],
          "properties": {
            "releaseId": { "type": "string", "minLength": 1 },
            "locator": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerRegion", "storageRegion", "sourceColocated"],
      "properties": {
        "workerRegion": { "type": "string", "minLength": 1 },
        "storageRegion": { "type": "string", "minLength": 1 },
        "sourceColocated": { "type": "boolean" }
      }
    },
    "cacheState": { "enum": ["cold", "warm", "mixed"] },
    "partitionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "bucketCount", "targetMemberBytes", "hardMaxMemberBytes"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "bucketCount": { "type": "integer", "minimum": 1 },
        "targetMemberBytes": { "type": "integer", "minimum": 1 },
        "hardMaxMemberBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "taskPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "maxInFlightStores", "maxAttempts", "checkpointIntervalSeconds"],
      "properties": {
        "policyId": { "type": "string", "minLength": 1 },
        "maxInFlightStores": { "type": "integer", "minimum": 1 },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "checkpointIntervalSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitCount",
        "deadlineSeconds",
        "maxWorkerCpu",
        "maxWorkerMemoryBytes",
        "maxCoordinatorMemoryBytes",
        "processorTargets"
      ],
      "properties": {
        "unitCount": { "type": "integer", "minimum": 1 },
        "deadlineSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "maxWorkerCpu": { "type": "number", "exclusiveMinimum": 0 },
        "maxWorkerMemoryBytes": { "type": "integer", "minimum": 1 },
        "maxCoordinatorMemoryBytes": { "type": "integer", "minimum": 1 },
        "processorTargets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "processorId",
              "deadlineSeconds",
              "maxConcurrency",
              "costEstimate",
              "providerLimits"
            ],
            "properties": {
              "processorId": { "type": "string", "minLength": 1 },
              "deadlineSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "maxConcurrency": { "type": "integer", "minimum": 1 },
              "costEstimate": { "type": "number", "minimum": 0 },
              "providerLimits": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/providerLimit" }
              }
            }
          }
        }
      }
    },
    "acceptanceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "decisionArtifact", "decisionArtifactDigest"],
      "properties": {
        "authorityId": { "type": "string", "minLength": 1 },
        "decisionArtifact": { "type": "string", "minLength": 1 },
        "decisionArtifactDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "median", "p95", "maximum"],
      "properties": {
        "minimum": { "type": "number", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "maximum": { "type": "number", "minimum": 0 }
      }
    },
    "implementationPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementationId", "configurationDigest"],
      "properties": {
        "implementationId": { "type": "string", "minLength": 1 },
        "configurationDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "locator", "digest"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "providerLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit", "maximum"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "maximum": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "profilePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "profileId",
        "version",
        "implementationId",
        "configurationDigest",
        "descriptionDigest",
        "capabilities"
      ],
      "properties": {
        "role": {
          "enum": [
            "ReleaseManifestProfile",
            "DocumentCatalogProfile",
            "RecordStorageProfile",
            "BlobStorageProfile",
            "DocumentStorePersistenceProfile",
            "ResultDeliveryProfile"
          ]
        },
        "profileId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "implementationId": { "type": "string", "minLength": 1 },
        "configurationDigest": { "$ref": "#/$defs/sha256" },
        "descriptionDigest": { "$ref": "#/$defs/sha256" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hasReleaseManifestProfile": {
      "contains": { "$ref": "#/$defs/releaseManifestProfilePin" },
      "minContains": 1,
      "maxContains": 1
    },
    "hasDocumentCatalogProfile": {
      "contains": { "$ref": "#/$defs/documentCatalogProfilePin" },
      "minContains": 1,
      "maxContains": 1
    },
    "hasRecordStorageProfile": {
      "contains": { "$ref": "#/$defs/recordStorageProfilePin" },
      "minContains": 1,
      "maxContains": 1
    },
    "hasBlobStorageProfile": {
      "contains": { "$ref": "#/$defs/blobStorageProfilePin" },
      "minContains": 1,
      "maxContains": 1
    },
    "hasDocumentStorePersistenceProfile": {
      "contains": { "$ref": "#/$defs/documentStorePersistenceProfilePin" },
      "minContains": 1,
      "maxContains": 1
    },
    "hasResultDeliveryProfile": {
      "contains": { "$ref": "#/$defs/resultDeliveryProfilePin" },
      "minContains": 1,
      "maxContains": 1
    },
    "releaseManifestProfilePin": {
      "type": "object",
      "required": ["role"],
      "properties": { "role": { "const": "ReleaseManifestProfile" } }
    },
    "documentCatalogProfilePin": {
      "type": "object",
      "required": ["role"],
      "properties": { "role": { "const": "DocumentCatalogProfile" } }
    },
    "recordStorageProfilePin": {
      "type": "object",
      "required": ["role"],
      "properties": { "role": { "const": "RecordStorageProfile" } }
    },
    "blobStorageProfilePin": {
      "type": "object",
      "required": ["role"],
      "properties": { "role": { "const": "BlobStorageProfile" } }
    },
    "documentStorePersistenceProfilePin": {
      "type": "object",
      "required": ["role"],
      "properties": { "role": { "const": "DocumentStorePersistenceProfile" } }
    },
    "resultDeliveryProfilePin": {
      "type": "object",
      "required": ["role"],
      "properties": { "role": { "const": "ResultDeliveryProfile" } }
    }
  }
}
